# build output and caches of jupyter lite build
dist/
.cache/
.jupyterlite.doit.db
*.jupyterlite.tgz
__pycache__/
.ipynb_checkpoints/

# graph files drawn by modelflow, regenerated when the notebooks run - except .png
# pictures, which a notebook can show in its text (publish copies them in with extra:)
**/graph/**
!**/graph/**/
!**/graph/**/*.png

# wheels from add_local_modelflow.cmd: a local experiment with unreleased source.
# The deployed site installs modelflowib from PyPI, so a wheel here must stay local
pypi/
